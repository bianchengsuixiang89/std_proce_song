# Default to local-only; explicitly allow reviewed project inputs.
/*
!/.gitignore
!/README.md

!/analysis/
/analysis/*
!/analysis/analyze.py
!/analysis/align.py

!/audio/
/audio/*
!/audio/song.wav

!/data/
/data/*
!/data/audio.json
!/data/lyrics.json

!/lyrics/
/lyrics/*
!/lyrics/lyrics.src.txt

!/docs/
/docs/*
!/docs/TREATMENT.md

!/refs/
/refs/*
!/refs/SOURCES.md

!/app/
/app/*
!/app/.gitignore
!/app/index.html
!/app/LICENSE.pdoom-video
!/app/package.json
!/app/package-lock.json
!/app/tsconfig.json
!/app/vite.config.ts

!/app/scripts/
/app/scripts/*
!/app/scripts/render.ts

!/app/src/
!/app/src/**
!/app/public/
/app/public/*
!/app/public/fonts/
!/app/public/fonts/**
!/app/public/refs/
/app/public/refs/*
!/app/public/refs/shangrao_notice.jpg
!/app/public/refs/shangrao_cctv.jpg
!/app/public/refs/guizhou_notice.jpg
!/app/public/refs/guizhou_bus_night.jpg
!/app/public/refs/guizhou_wreck.jpg

# Exclude private configuration and generated files even in allowed folders.
.git/
.env
.env.*
.dev.vars
.dev.vars.*
.npmrc
.netrc
.ssh/
.aws/
.azure/
.codex/
.claude/
.wrangler/
.vscode/
.idea/
node_modules/
dist/
out/
cache/
.cache/
__pycache__/
.venv/
venv/
coverage/
logs/
tmp/
temp/
secrets/
credentials
credentials.*
secrets.*
*.pem
*.key
*.p12
*.pfx
*.keystore
*.jks
id_rsa*
id_ed25519*
id_ecdsa*
*.log
*.tmp
*.bak
*.pyc
*.pyo
*.tsbuildinfo
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
